  <p>Momento actual: ${new Date().toLocaleTimeString()}</p>
  <p class="real-time">Momento actual real:</p>
  <Greeting
    client:load
    messages={["Hola, Que pedos", "Que ondas prrin", "Uwu"]}
  />
</BaseLayout>
